{
  "name": "@berrypjh/react-ui",
  "projectType": "library",
  "sourceRoot": "libs/react-ui/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "parallel": false,
        "commands": ["nx run @berrypjh/react-ui:build-js", "nx run @berrypjh/react-ui:build-types"]
      }
    },
    "build-js": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "nx run @berrypjh/react-ui:bundle-js",
          "find libs/react-ui/dist -type f \\( -name '*.d.ts' -o -name '*.d.ts.map' \\) -delete",
          "rm -rf libs/react-ui/dist/src"
        ],
        "parallel": false
      }
    },
    "bundle-js": {
      "executor": "@nx/rollup:rollup",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "main": "libs/react-ui/src/index.ts",
        "outputPath": "libs/react-ui/dist",
        "tsConfig": "libs/react-ui/tsconfig.rollup.json",
        "compiler": "babel",
        "format": ["esm"],
        "outputFileName": "index",
        "extractCss": "index.css",
        "external": [
          "react",
          "react-dom",
          "react/jsx-runtime",
          "@berrypjh/ui-core",
          "@berrypjh/design-tokens"
        ],
        "assets": [
          {
            "input": ".",
            "output": ".",
            "glob": "README.md"
          }
        ],
        "rollupConfig": "libs/react-ui/rollup.config.cjs",
        "skipTypeCheck": true
      }
    },
    "build-types": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist/types"],
      "options": {
        "command": "tsc -p libs/react-ui/tsconfig.types.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/react-ui/tsconfig.types.json --noEmit"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "libs/react-ui/vitest.config.mts",
        "watch": false,
        "reportsDirectory": "libs/react-ui/test-output/vitest/coverage"
      },
      "configurations": {
        "ci": {
          "runMode": "run"
        }
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["build"]
    }
  }
}
