{
  "extends": "../../tsconfig.lib.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "lib": ["es2022", "dom"],
    "types": ["node", "@nx/react/typings/cssmodule.d.ts", "@nx/react/typings/image.d.ts"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "out-tsc",
    "dist",
    "**/*.spec.*",
    "**/*.test.*",
    "vite.config.*",
    "vitest.config.*",
    "eslint.config.*",
    "**/*.stories.*",
    ".storybook/**/*"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "references": [
    {
      "path": "../ui-core/tsconfig.lib.json"
    }
  ]
}
