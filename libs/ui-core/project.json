{
  "name": "@berrypjh/ui-core",
  "projectType": "library",
  "sourceRoot": "libs/ui-core/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "commands": [
          "nx run @berrypjh/ui-core:build-js",
          "mkdir -p libs/ui-core/dist/css && cp libs/design-tokens/dist/css/variables.css libs/ui-core/dist/css/index.css"
        ],
        "parallel": false
      }
    },
    "build-js": {
      "executor": "@nx/vite:build",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "configFile": "libs/ui-core/vite.config.mts",
        "outputPath": "libs/ui-core/dist"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/ui-core/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "libs/ui-core/vitest.config.mts",
        "watch": false,
        "reportsDirectory": "libs/ui-core/test-output/vitest/coverage"
      },
      "configurations": {
        "ci": {
          "runMode": "run"
        }
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["build"]
    }
  }
}
