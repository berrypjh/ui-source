{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "target": "ES2022",
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/index.ts"]
}
