{
  "name": "@berrypjh/design-tokens",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/design-tokens/src",
  "projectType": "library",
  "targets": {
    "build:tokens": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx libs/design-tokens/src/build.ts"
      }
    },
    "build:ts": {
      "executor": "nx:run-commands",
      "dependsOn": ["build:tokens"],
      "options": {
        "command": "tsc -p libs/design-tokens/tsconfig.lib.json"
      }
    },
    "build": {
      "executor": "nx:noop",
      "dependsOn": ["build:tokens", "build:ts"]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  },
  "tags": [],
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  }
}
