    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-storybook": "^10.2.19",
    "husky": "^8.0.0",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^16.4.0",
    "metro-config": "~0.83.0",
    "metro-resolver": "~0.83.0",
    "nx": "22.3.3",
    "postcss": "8.4.38",
