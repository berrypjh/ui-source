{
  "name": "@berrypjh/ui-source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve demo-web",
    "start:mobile:expo": "cd apps/demo-mobile && expo start",
    "build": "nx run-many -t build --all",
    "build:libs": "nx run-many -t build --projects=@berrypjh/ui-core,@berrypjh/react-ui",
    "build:design-tokens": "nx run @berrypjh/design-tokens:build",
    "build:commit-mcp": "nx run commit-mcp:build",
    "publish:design-tokens": "nx run @berrypjh/design-tokens:publish",
    "storybook": "nx storybook @berrypjh/react-ui",
    "build-storybook": "nx build-storybook @berrypjh/react-ui",
    "test": "nx run-many -t test --all",
    "test:ci": "nx run-many -t test-ci --all",
    "test:watch": "nx run-many -t test --all --watch",
    "test:watch:ci": "nx run-many -t test-ci --all --watch",
    "typecheck": "nx run-many -t typecheck --all",
    "lint": "nx run-many -t lint --all",
    "lint:fix": "nx run-many -t lint --all --fix",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "release:local": "tsx tools/scripts/release/release-local.ts",
    "local-registry": "nx local-registry",
    "reset": "nx reset",
    "prepare": "husky install"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@babel/runtime": "~7.27.6",
